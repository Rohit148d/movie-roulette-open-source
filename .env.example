# Movie Roulette server-side configuration.
# Copy to .env.local for local Next.js development (`cp .env.example .env.local`).
# These values are server-only: never prefix them with NEXT_PUBLIC_.

# Preferred authentication: TMDB v4 read access token.
# https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=

# Optional fallback for a legacy v3 API key. Only used when no v4 token is set.
TMDB_API_KEY=

# Explicit local/test mode. When "true", the app serves a deterministic local
# sample dataset instead of calling TMDB and labels every response as demo.
# Never enable this for a production deployment.
TMDB_DEMO_MODE=false

# Optional. Overrides the TMDB API base URL. Must be HTTPS, or http://localhost
# for a local proxy used in tests.
TMDB_API_BASE_URL=
